# Skopiuj ten plik do `.env` albo uruchom `./scripts/init-env.sh`.
# `.env` jest ignorowany przez Git. W repozytorium wolno trzymać wyłącznie placeholdery.

POSTGRES_DB=task_encoder
POSTGRES_USER=task_encoder
POSTGRES_PASSWORD=change-me

# Backend uruchamiany lokalnie, poza Compose. W Compose DB_URL jest ustawiany
# na nazwę serwisu `db`.
DB_URL=jdbc:postgresql://localhost:5432/task_encoder
DB_USERNAME=task_encoder
DB_PASSWORD=change-me

# Klucz AES-256 w base64 (32 bajty). Wygeneruj go raz:
#   ./scripts/init-env.sh
# Zmiana lub utrata klucza po zapisaniu wiadomości uniemożliwi ich odszyfrowanie.
APP_CRYPTO_KEY=

# Profil `local` tworzy konta demonstracyjne alice i bob.
SPRING_PROFILES_ACTIVE=local

# Ustaw `true` dopiero za HTTPS. Lokalne HTTP wymaga `false`, inaczej
# przeglądarka nie odeśle cookie sesji.
SESSION_COOKIE_SECURE=false
